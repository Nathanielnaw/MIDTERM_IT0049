CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'Asia/Manila'

# Required when seeding the local assessment account. This is hashed at runtime
# and is never written to the repository or stored as plain text in the database.
TFA4_DEMO_PASSWORD =

# MySQL / MariaDB: create an empty tasks_today database before migrating.
database.default.hostname = localhost
database.default.database = tasks_today
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.port = 3306

# For SQLite, replace database and DBDriver above with:
# database.default.database = tasks-today.sqlite
# database.default.DBDriver = SQLite3
# CodeIgniter stores a relative SQLite filename in writable/.

# Required for first POS seeding; choose a private 12-72 character password.
POS_DEMO_PASSWORD =
